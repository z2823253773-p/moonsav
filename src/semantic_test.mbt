test "default core UTF8 preserves initial BOM in labels and string values" {
  let d = read_bytes(bom_fixture)
  assert_eq(d.rows[0][0].text, Some("\uFEFFA"))
  assert_eq(d.dictionary.variables[0].label, Some("\uFEFFlabel"))
}
