///|
test "read and retain UTF8 semantic values on every core backend" {
  let data = read_bytes(survey_fixture)
  assert_eq(data.rows.length(), 5)
  assert_eq(data.dictionary.variables[0].label, Some("得分"))
  assert_eq(data.rows[0][1].text, Some("0012   "))
  assert_eq(data.rows[1][1].text, Some("NA     "))
  assert_eq(data.rows[2][0].missing_kind(), "user")
  assert_eq(data.rows[3][0].missing_kind(), "system")
  assert_eq(data.dictionary.variables[0].value_label_for(data.rows[4][0]), None)
}

///|
test "scan Stop and callback failure are not full success" {
  let s = scan_bytes(survey_fixture, fn(_) {  }, fn(_) { Stop })
  assert_eq(s.completed, false)
  assert_eq(s.actual_rows, 1)
  let e = try {
    ignore(
      scan_bytes(survey_fixture, fn(_) {  }, fn(_) raise {
        fail("caller failure")
      }),
    )
    None
  } catch {
    e => Some(e.info().code)
  }
  assert_eq(e, Some("ConsumerFailed"))
}

///|
test "row and collected cell limits accept equality and reject one excess" {
  let l = Limits::default()
  let data = read_bytes(survey_fixture, options={
    ..Options::default(),
    limits: { ..l, rows: 5, cells: 15 },
  })
  assert_eq(data.rows.length(), 5)
  let e = try {
    ignore(
      read_bytes(survey_fixture, options={
        ..Options::default(),
        limits: { ..l, rows: 4 },
      }),
    )
    None
  } catch {
    e => Some(e.info().code)
  }
  assert_eq(e, Some("ResourceLimit"))
  let e = try {
    ignore(
      read_bytes(survey_fixture, options={
        ..Options::default(),
        limits: { ..l, cells: 14 },
      }),
    )
    None
  } catch {
    e => Some(e.info().code)
  }
  assert_eq(e, Some("ResourceLimit"))
}

