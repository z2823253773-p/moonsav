///|
fn assert_limited(b : Bytes, limits : Limits) -> Unit raise {
  let code = try {
    ignore(read_bytes(b, options={ ..Options::default(), limits, }))
    None
  } catch {
    e => Some(e.info().code)
  }
  assert_eq(code, Some("ResourceLimit"))
}

///|
test "all byte-core budgets accept equality and reject one unit less" {
  let l = Limits::default()
  let limits = {
    ..l,
    input_bytes: 301,
    dictionary_bytes: 280,
    physical_slots: 1,
    row_bytes: 8,
    rows: 2,
    cells: 2,
    retained_bytes: 16,
    extension_bytes: 32,
  }
  assert_eq(
    read_bytes(minimum, options={ ..Options::default(), limits, }).rows.length(),
    2,
  )
  assert_limited(minimum, { ..l, input_bytes: 300 })
  assert_limited(minimum, { ..l, dictionary_bytes: 279 })
  assert_limited(minimum, { ..l, row_bytes: 7 })
  assert_limited(minimum, { ..l, rows: 1 })
  assert_limited(minimum, { ..l, cells: 1 })
  assert_limited(minimum, { ..l, retained_bytes: 15 })
  assert_limited(minimum, { ..l, extension_bytes: 31 })
  assert_eq(
    read_bytes(two_variables, options={
      ..Options::default(),
      limits: { ..l, variables: 2 },
    }).rows.length(),
    1,
  )
  assert_limited(two_variables, { ..l, variables: 1 })
  assert_eq(
    read_bytes(string_nine, options={
      ..Options::default(),
      limits: { ..l, string_bytes: 9, physical_slots: 2 },
    }).rows.length(),
    1,
  )
  assert_limited(string_nine, { ..l, string_bytes: 8 })
  assert_limited(string_nine, { ..l, physical_slots: 1 })
  assert_eq(
    read_bytes(label_six, options={
      ..Options::default(),
      limits: { ..l, label_bytes: 6 },
    }).rows.length(),
    1,
  )
  assert_limited(label_six, { ..l, label_bytes: 5 })
}
