///|
test "core reads big-endian numerics, extended counts, ranges, labels and display on every backend" {
  assert_eq(probe_header(endian_fixture), 2)
  let d = read_bytes(endian_fixture)
  assert_eq(d.dictionary.byte_order, "big")
  assert_eq(d.dictionary.declared_rows, Some(3))
  assert_eq(d.dictionary.weight_variable, Some(0))
  assert_eq(d.dictionary.variables[0].display_width, Some(12))
  assert_eq(d.dictionary.variables[0].value_labels[0].label, "User missing")
  assert_eq(d.rows[0][0].decimal, Some("1"))
  assert_eq(d.rows[0][0].missing, "user")
  assert_eq(d.rows[1][0].decimal, Some("99"))
  assert_eq(d.rows[2][0].missing, "system")
}
