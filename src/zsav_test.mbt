///|
test "portable inspect recognizes compression2 without inflater; scan requires an adapter" {
  assert_eq(inspect_bytes(zsav_multi).compression, 2)
  let error = try { ignore(read_bytes(zsav_multi)); None } catch {
    SavFailure(e) => Some(e)
  }
  assert_eq(error.unwrap().code, "UnsupportedCompression")
}

///|
test "ZSAV checks total inflation budget before invoking the primitive" {
  let o = Options::default()
  let options = { ..o, limits: { ..o.limits, inflated_bytes: 1 } }
  let error = try { ignore(read_bytes(zsav_multi, options~)); None } catch {
    SavFailure(e) => Some(e)
  }
  assert_eq(error.unwrap().code, "ResourceLimit")
}
