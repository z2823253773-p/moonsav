+///|
+fn format_fixture(print : Int, write : Int) -> Bytes {
+  Bytes::makei(survey_fixture.length(), i => {
+    if i == 194 {
+      print.to_byte()
+    } else if i == 198 {
+      write.to_byte()
+    } else {
+      survey_fixture[i]
+    }
+  })
