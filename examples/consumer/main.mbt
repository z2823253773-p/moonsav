fn exercise() -> Unit raise {
 let data = @moonsav.read_bytes(fixture)
 let kept : Array[Array[@moonsav.Cell]] = []
 let summary = @moonsav.scan_bytes(fixture, fn(_d) {}, fn(row) { kept.push(row); @moonsav.Continue })
 assert_eq(summary.actual_rows, 5)
 assert_eq(kept[0][1].text, Some("0012   "))
 assert_eq(kept[1][1].text, Some("NA     "))
 let score = data.dictionary.variables[0]
 assert_eq(score.value_label_for(data.rows[0][0]), Some("A"))
 assert_eq(score.value_label_for(data.rows[4][0]), None)
 let present = data.rows.filter(row => !row[0].is_missing())
 assert_eq(present.length(), 3)
 let stopped = @moonsav.scan_bytes(fixture, fn(_d) {}, fn(_row) { @moonsav.Stop })
 assert_eq(stopped.completed, false)
 assert_eq(stopped.actual_rows, 1)
 let failure = try {ignore(@moonsav.scan_bytes(fixture, fn(_d) {}, fn(_row) raise { fail("consumer failed") })); None} catch { e => Some(e.info().code) }
 assert_eq(failure, Some("ConsumerFailed"))
 println("U1: labels, unlabeled valid value, ID text, missing filter, retained rows, Stop and consumer failure passed")
}

fn main { try exercise() catch { e => { println(e.to_string()); abort("U1 failed") } } }
